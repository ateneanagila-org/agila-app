# AGILA CATalog — environment template
#
# Copy to `.env` and fill in. Values come from the Vercel project's
# environment settings; ask an admin for access.
#
# NOTE: local development points at PRODUCTION. There is no staging
# environment — your edits are real edits, and anything you change that
# syncs reaches AGILA's spreadsheet on the next production cron tick.
# Read docs/development.md §2 before running the app.
#
# Every variable below is read by application code. If you see others in
# an existing .env (SUPABASEDB_PASS, SUPABASE_AUTH_EXTERNAL_*,
# PHOTO_WEBAPP_*, APP_SCRIPT_MODE_PROMPT_SECRET), they are either Supabase
# dashboard config or legacy from a deleted Apps Script web app — the app
# does not read them and you do not need them.

# ── Database (Supabase) ──────────────────────────────────────────────────
# Pooled connection used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection. Used ONLY by `pnpm drizzle-kit push`,
# which cannot run through Supabase's transaction pooler.
DIRECT_DATABASE_URL=

# ── Supabase client + storage ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this to the browser.
NEXT_SUPABASE_SERVICE_ROLE_KEY=

# ── Google Sheets sync ───────────────────────────────────────────────────
# The service account's JSON key, as a single-line string.
# Without it the app still runs; sync is what breaks.
SERVICE_ACCOUNT_CREDENTIALS=
CATALOG_SPREADSHEET_ID=

# ── Cron ─────────────────────────────────────────────────────────────────
# Authenticates POSTs to /api/cron/sync. Must match the Cloudflare
# Worker's CRON_SECRET exactly — rotate one alone and every tick 401s.
CRON_SECRET=

# ── Public URLs ──────────────────────────────────────────────────────────
# Used to build the sitemap, robots.txt, and catalog canonical URLs.
# A wrong value fails SILENTLY: the app works, and you find out when the
# catalog drops out of Google's index weeks later.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Cloudflare Worker's target. Same value as above in production.
APP_URL=http://localhost:3000

# ── Alerts (optional) ────────────────────────────────────────────────────
# Where sync failures are reported. Leave blank locally — without it,
# failures are logged instead of sent, which is fine for development.
DISCORD_WEBHOOK_URL=
